# ==============================================================================
# ALGORBIT FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust variables as necessary
# ==============================================================================

# Backend API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000
REACT_APP_API_URL=http://localhost:8000/api

# Development Server Settings
PORT=3000
FAST_REFRESH=true
GENERATE_SOURCEMAP=false

# Application Metadata
REACT_APP_NAME=Algorbit
REACT_APP_DESCRIPTION=Interactive Graph Algorithm Visualizer
REACT_APP_VERSION=1.0.0

# Browser Launch (set to 'none' if you prefer not to auto-launch the browser on npm start)
# BROWSER=none

# Google OAuth 2.0 Client ID
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
