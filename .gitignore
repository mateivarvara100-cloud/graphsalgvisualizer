# ==============================================================================
# Git Ignore Configuration for Algorbit (Public Repository Ready)
# ==============================================================================

# Node / Frontend Dependencies & Builds
node_modules/
/frontend/node_modules/
/.pnp
.pnp.js
build/
/frontend/build/
dist/
/coverage/

# Environment variables & secrets (keep .env.example templates tracked)
.env
.env.*
*.env
backend/.env
frontend/.env
*/.env
*/**/.env
!.env.example
!frontend/.env.example
!backend/.env.example

# Python virtual environments, cache & compiled files
__pycache__/
*.py[cod]
*$py.class
venv/
backend/venv/
*/venv/
.venv/
*/.venv/
env/
*/env/
.pytest_cache/
*.egg-info/

# IDEs & Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
sent_emails.log
backend/sent_emails.log

# Temporary Scratch Files & Local Testing
scratch/
.agents/
