# ==============================================================================
# ALGORBIT BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Metadata
APP_NAME=Algorbit API
APP_VERSION=1.0.0

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Security Controls
ENABLE_DOCS=true
MAX_GRAPH_NODES=500

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
ALLOWED_METHODS=GET,POST,OPTIONS
ALLOWED_HEADERS=*

# MongoDB Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=algorbit_db

# Security Tokens & Salting
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN_DAYS=7
BCRYPT_ROUNDS=12

# OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gemini Generative AI Assistant Key
GEMINI_API_KEY=your_gemini_api_key_here

# Production SMTP Email Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Algorbit Security
